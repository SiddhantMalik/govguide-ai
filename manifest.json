{
  "manifest_version": 3,
  "name": "CivicEase: Government Form Assistant",
  "version": "1.0.0",
  "description": "Simplifies government forms with AI overlays.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*.gov/*", "https://*.healthcare.gov/*"],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.gov/*", "https://*.healthcare.gov/*"],
      "js": ["src/content.tsx"]
    }
  ]
}
